--//==================================================
--// HELD ITEM
--//==================================================

local function GetHeldTool()
    local Character = Player.Character

    if not Character then
        return nil
    end

    for _, Object in ipairs(Character:GetChildren()) do
        if Object:IsA("Tool") then
            return Object
        end
    end

    return nil
end

local function GetToolID(Tool)

    if not Tool then
        return nil
    end

    local Names = {
        "ID",
        "Id",
        "ItemID",
        "ItemId",
        "AssetID",
        "AssetId"
    }

    for _, Name in ipairs(Names) do
        local Value = Tool:GetAttribute(Name)

        if Value ~= nil then
            return tostring(Value)
        end
    end

    for _, Object in ipairs(Tool:GetDescendants()) do

        if Object:IsA("StringValue")
        or Object:IsA("IntValue")
        or Object:IsA("NumberValue") then

            local Name = Object.Name:lower()

            if Name == "id"
            or Name == "itemid"
            or Name == "item_id"
            or Name == "assetid"
            or Name == "asset_id" then

                return tostring(Object.Value)
            end
        end
    end

    return nil
end

local function UpdateHeldItem()

    local Tool = GetHeldTool()

    if not Tool then
        ItemName.Text = "No Item"
        IDText.Text = "ID: NONE"
        return
    end

    ItemName.Text = Tool.Name

    local FoundID = GetToolID(Tool)

    if FoundID then
        IDText.Text = "ID: " .. FoundID
    elseif ItemID ~= "" then
        IDText.Text = "ID: " .. ItemID
    else
        IDText.Text = "ID: NONE"
    end
end

RunService.Heartbeat:Connect(UpdateHeldItem)

