--//==================================================
--// FIND ITEM
--//==================================================

local function FindItemByID(ID)

    if not ID or ID == "" then
        return nil
    end

    local NumberID = tonumber(ID)

    for _, Object in ipairs(game:GetDescendants()) do

        if Object.Name == ID then
            return Object
        end

        if NumberID then

            local Attributes = {
                "ID",
                "Id",
                "ItemID",
                "ItemId",
                "AssetID",
                "AssetId"
            }

            for _, Attribute in ipairs(Attributes) do

                local Value = Object:GetAttribute(Attribute)

                if Value == NumberID
                or tostring(Value) == ID then
                    return Object
                end
            end
        end
    end

    return nil
end

--//==================================================
--// SPAWN VISUAL ITEM
--//==================================================

local function SpawnVisualItem()

    local Character = Player.Character
    if not Character then return end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Root then return end

    local Source = FindItemByID(ItemID)
    if not Source then return end

    local Fake

    pcall(function()
        fake = Source:Clone()
    end)

    if not Fake then return end

    Fake.Name = "VisualItem_" .. ItemID
    Fake.Parent = workspace

    local Target =
        Root.CFrame * CFrame.new(0, -1, -SPAWN_DISTANCE)

    if Fake:IsA("Model") then

        Fake:PivotTo(Target)

        for _, Part in ipairs(Fake:GetDescendants()) do
            if Part:IsA("BasePart") then
                Part.Anchored = false
                Part.CanCollide = true
                Part.Massless = false
            end
        end

    elseif Fake:IsA("BasePart") then

        Fake.CFrame = Target
        Fake.Anchored = false
        Fake.CanCollide = true
        Fake.Massless = false

    else

        Fake:Destroy()
        return
    end

    table.insert(VisualItems, Fake)

    while #VisualItems > MAX_ITEMS do

        local Old = table.remove(VisualItems, 0)

        if Old and Old.Parent then
            Old:Destroy()
        end
    end
end

